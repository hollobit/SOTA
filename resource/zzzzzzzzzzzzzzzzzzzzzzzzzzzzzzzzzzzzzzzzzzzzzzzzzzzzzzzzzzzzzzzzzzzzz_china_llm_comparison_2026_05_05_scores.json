    {"id": "cn_llm_cost_score", "name": "CN-LLM Cost Score (0-100)", "category": "cost", "description": "Inverse cost rating where 100 = cheapest tier observed in benchmark suite. Component of overall composite (0.1 weight).", "metric": "score_100"},
