    {"id": "cn_llm_long_doc_understanding", "name": "CN-LLM Long Document Understanding", "category": "language", "description": "Information extraction, logic mapping, critical reading on long Chinese documents. Scored 0-20 by independent reviewer. Source: github.com/happypaul2139-svg/LLM-Of-China-Comparison.", "metric": "score_20"},
    {"id": "cn_llm_code_writing", "name": "CN-LLM Code Writing", "category": "coding", "description": "Frontend development, algorithm design, engineering completeness on Chinese-context coding tasks. 0-20 score.", "metric": "score_20"},
